# Airflow configuration
AIRFLOW_UID=50000
AIRFLOW_PROJ_DIR=..

# Must match POSTGRES_PASSWORD in the root .env
WEATHER_DB_PASSWORD=replace_with_the_same_weather_database_password

# Airflow metadata PostgreSQL
AIRFLOW_DB_PASSWORD=replace_with_a_different_secure_password

# Generate a valid Fernet key
FERNET_KEY=replace_with_generated_fernet_key

# Airflow API authentication
AIRFLOW__API_AUTH__JWT_SECRET=replace_with_a_secure_random_secret
AIRFLOW__API_AUTH__JWT_ISSUER=airflow

# Airflow web user
_AIRFLOW_WWW_USER_USERNAME=airflow
_AIRFLOW_WWW_USER_PASSWORD=replace_with_a_secure_password
